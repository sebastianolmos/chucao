<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Source artwork; stable resource aliases are used by the views. -->
    <ApplicationImageFile>..\..\Assets\Images\stand.png</ApplicationImageFile>
    <ApplicationIconFile>..\..\Assets\Images\icono.ico</ApplicationIconFile>
    <BirdFly1ImageFile>..\..\Assets\Images\fly1.png</BirdFly1ImageFile>
    <BirdFly2ImageFile>..\..\Assets\Images\fly2.png</BirdFly2ImageFile>
    <TimerCompletionSoundFile>..\..\Assets\Sounds\bird.wav</TimerCompletionSoundFile>
    <ApplicationIcon>$(ApplicationIconFile)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <EmbeddedResource Include="Resources\Translations.csv" />
    <!-- MediaPlayer reads a local file; include the optional preview sound in build/publish output. -->
    <Content Include="$(TimerCompletionSoundFile)" Link="Assets\Sounds\TimerFinished.wav"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(TimerCompletionSoundFile)')" />
    <Resource Include="$(ApplicationImageFile)" Link="Assets\Images\Application.png" />
    <Resource Include="$(ApplicationIconFile)" Link="Assets\Images\Application.ico" />
    <Resource Include="$(BirdFly1ImageFile)" Link="Assets\Images\BirdFly1.png" />
    <Resource Include="$(BirdFly2ImageFile)" Link="Assets\Images\BirdFly2.png" />
    <Resource Include="..\..\Assets\Images\tronco.png" Link="Assets\Images\Stump.png" />
    <Resource Include="..\..\Assets\Fonts\Comfortaa-Light.ttf" Link="Assets\Fonts\Comfortaa-Light.ttf" />
    <Resource Include="..\..\Assets\Fonts\Comfortaa-Bold.ttf" Link="Assets\Fonts\Comfortaa-Bold.ttf" />
    <Resource Include="..\..\Assets\Fonts\Comfortaa-Regular.ttf" Link="Assets\Fonts\Comfortaa-Regular.ttf" />
    <None Include="..\..\Assets\Fonts\OFL.txt" Link="Assets\Fonts\OFL.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
