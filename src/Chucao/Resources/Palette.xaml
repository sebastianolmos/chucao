<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Edit the palette here. The overlay keeps the original alpha 80 (about 50%). -->
    <Color x:Key="TextColor">#5C2D00</Color>
    <Color x:Key="WindowFrameColor">#FFBF4F</Color>
    <Color x:Key="WindowCaptionColor">#FFBF4F</Color>
    <Color x:Key="ViewBackgroundColor">#FFF5DB</Color>
    <Color x:Key="OverlayColor">#805C2D00</Color>
    <Color x:Key="ScrollTrackColor">#FFDA99</Color>
    <Color x:Key="ScrollThumbColor">#FFB363</Color>
    <Color x:Key="SettingsColor">#FFE4B5</Color>
    <Color x:Key="SettingsHoverColor">#FFD080</Color>
    <Color x:Key="BackColor">#FFFCA8</Color>
    <Color x:Key="BackHoverColor">#FFFA6E</Color>
    <Color x:Key="LanguageToEnglishColor">#BFBFFF</Color>
    <Color x:Key="LanguageToEnglishHoverColor">#8F8FFF</Color>
    <Color x:Key="LanguageToSpanishColor">#FFCBB8</Color>
    <Color x:Key="LanguageToSpanishHoverColor">#FFA482</Color>
    <Color x:Key="ListCardColor">#BDF9FF</Color>
    <Color x:Key="ListCardHoverColor">#85F5FF</Color>
    <Color x:Key="GreenColor">#CDFAB4</Color>
    <Color x:Key="GreenHoverColor">#B2FF87</Color>
    <Color x:Key="RedColor">#FFC4C4</Color>
    <Color x:Key="RedHoverColor">#FF8F8F</Color>
    <Color x:Key="PurpleColor">#ECC9FF</Color>
    <Color x:Key="PurpleHoverColor">#DD9CFF</Color>
    <Color x:Key="BlueColor">#C7CFFF</Color>
    <Color x:Key="BlueHoverColor">#91A2FF</Color>
    <Color x:Key="PinkColor">#FECCFF</Color>
    <Color x:Key="PinkHoverColor">#FDA1FF</Color>
    <Color x:Key="OrangeColor">#FFDFAB</Color>
    <Color x:Key="OrangeHoverColor">#FFC970</Color>
    <Color x:Key="AnimationColor">#83DDF7</Color>
    <Color x:Key="AnimationGroundColor">#86D964</Color>
    <Color x:Key="AnimationPathColor">#AAA184</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="WindowFrameBrush" Color="{DynamicResource WindowFrameColor}" />
    <SolidColorBrush x:Key="WindowCaptionBrush" Color="{DynamicResource WindowCaptionColor}" />
    <SolidColorBrush x:Key="ViewBackgroundBrush" Color="{DynamicResource ViewBackgroundColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{DynamicResource ScrollTrackColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="SettingsBrush" Color="{DynamicResource SettingsColor}" />
    <SolidColorBrush x:Key="SettingsHoverBrush" Color="{DynamicResource SettingsHoverColor}" />
    <SolidColorBrush x:Key="BackBrush" Color="{DynamicResource BackColor}" />
    <SolidColorBrush x:Key="BackHoverBrush" Color="{DynamicResource BackHoverColor}" />
    <SolidColorBrush x:Key="LanguageToEnglishBrush" Color="{DynamicResource LanguageToEnglishColor}" />
    <SolidColorBrush x:Key="LanguageToEnglishHoverBrush" Color="{DynamicResource LanguageToEnglishHoverColor}" />
    <SolidColorBrush x:Key="LanguageToSpanishBrush" Color="{DynamicResource LanguageToSpanishColor}" />
    <SolidColorBrush x:Key="LanguageToSpanishHoverBrush" Color="{DynamicResource LanguageToSpanishHoverColor}" />
    <SolidColorBrush x:Key="ListCardBrush" Color="{DynamicResource ListCardColor}" />
    <SolidColorBrush x:Key="ListCardHoverBrush" Color="{DynamicResource ListCardHoverColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{DynamicResource GreenColor}" />
    <SolidColorBrush x:Key="GreenHoverBrush" Color="{DynamicResource GreenHoverColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{DynamicResource RedColor}" />
    <SolidColorBrush x:Key="RedHoverBrush" Color="{DynamicResource RedHoverColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{DynamicResource PurpleColor}" />
    <SolidColorBrush x:Key="PurpleHoverBrush" Color="{DynamicResource PurpleHoverColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="BlueHoverBrush" Color="{DynamicResource BlueHoverColor}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}" />
    <SolidColorBrush x:Key="PinkHoverBrush" Color="{DynamicResource PinkHoverColor}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{DynamicResource OrangeColor}" />
    <SolidColorBrush x:Key="OrangeHoverBrush" Color="{DynamicResource OrangeHoverColor}" />
    <SolidColorBrush x:Key="AnimationBrush" Color="{DynamicResource AnimationColor}" />
    <SolidColorBrush x:Key="AnimationGroundBrush" Color="{DynamicResource AnimationGroundColor}" />
    <SolidColorBrush x:Key="AnimationPathBrush" Color="{DynamicResource AnimationPathColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}" />

    <!-- Geometry and spacing. Shadow offsets extend only to the right and down. -->
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">4</CornerRadius>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="ButtonShadowOffsetX">3</sys:Double>
    <sys:Double x:Key="ButtonShadowOffsetY">3</sys:Double>
    <sys:Double x:Key="DisabledControlOpacity">0.5</sys:Double>
    <sys:Double x:Key="ScrollBarThickness">14</sys:Double>
    <sys:Double x:Key="TimerDigitCellWidth">48</sys:Double>
    <sys:Double x:Key="TimerSeparatorCellWidth">20</sys:Double>
    <sys:Double x:Key="AnimationCanvasWidth">380</sys:Double>
    <sys:Double x:Key="AnimationCanvasHeight">260</sys:Double>
    <sys:Double x:Key="AnimationCornerRadius">12</sys:Double>
    <!-- Common image height at 100%; scale multiplies both axes without distortion. -->
    <sys:Double x:Key="BirdBaseHeight">80</sys:Double>
    <sys:Double x:Key="BirdInitialScale">0.25</sys:Double>
    <sys:Double x:Key="BirdFinalScale">1</sys:Double>
    <Thickness x:Key="DefaultButtonPadding">12,8</Thickness>
    <Thickness x:Key="ListCardMargin">6</Thickness>
    <Thickness x:Key="AddListMargin">6,12,6,6</Thickness>
    <Thickness x:Key="LeftActionMargin">0,0,6,4</Thickness>
    <Thickness x:Key="MiddleActionMargin">6,0,6,4</Thickness>
    <Thickness x:Key="RightActionMargin">6,0,0,4</Thickness>
    <Thickness x:Key="InlineActionMargin">0,0,10,4</Thickness>
    <Thickness x:Key="DialogActionMargin">0,0,12,4</Thickness>
    <Thickness x:Key="FinalDialogActionMargin">0,0,0,4</Thickness>
    <Thickness x:Key="HeaderButtonMargin">0,0,3,3</Thickness>
    <Thickness x:Key="ActionRowMargin">0,0,0,16</Thickness>
</ResourceDictionary>
