<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
        <Grid x:Name="ButtonRoot" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource TextBrush}" CornerRadius="{DynamicResource ButtonCornerRadius}"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="{DynamicResource ButtonShadowOffsetX}" Y="{DynamicResource ButtonShadowOffsetY}" />
                </Border.RenderTransform>
            </Border>
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource InputCornerRadius}" Margin="3" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonRoot" Property="Opacity" Value="{DynamicResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AppButtonStyle" TargetType="Button" BasedOn="{StaticResource TypographyButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SettingsBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource DefaultButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}" />
    <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource GreenBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GreenHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource RedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RedHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PurpleButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PurpleBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PurpleHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource BlueBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BlueHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PinkButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PinkBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrangeButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource OrangeBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource OrangeHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource BackBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BackHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SettingsBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ListCardButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource ListCardBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ListCardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AddListButtonStyle" TargetType="Button" BasedOn="{StaticResource GreenButtonStyle}">
        <Setter Property="FontSize" Value="{DynamicResource AddListFontSize}" />
    </Style>
    <Style x:Key="LanguageButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource LanguageToSpanishBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Localization.CurrentLanguage}" Value="es">
                <Setter Property="Background" Value="{DynamicResource LanguageToEnglishBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Localization.CurrentLanguage}" Value="en" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LanguageToSpanishHoverBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Localization.CurrentLanguage}" Value="es" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LanguageToEnglishHoverBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource TypographyTextBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource WindowFrameBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource InputCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{DynamicResource ScrollTrackBrush}" CornerRadius="6">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="ScrollThumb" Style="{StaticResource ScrollThumbStyle}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="Increase" Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0" />
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="18" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="{DynamicResource ScrollBarThickness}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="MinutesToggleTemplate" TargetType="ToggleButton">
        <Grid>
            <Border Background="{DynamicResource TextBrush}" CornerRadius="{DynamicResource ButtonCornerRadius}">
                <Border.RenderTransform>
                    <TranslateTransform X="{DynamicResource ButtonShadowOffsetX}" Y="{DynamicResource ButtonShadowOffsetY}" />
                </Border.RenderTransform>
            </Border>
            <Border x:Name="Face" Background="{DynamicResource SettingsBrush}" BorderBrush="{DynamicResource TextBrush}"
                    BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}">
                <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox" BasedOn="{StaticResource TypographyComboBoxStyle}">
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" Template="{StaticResource MinutesToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter Margin="10,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Border x:Name="ComboFocus" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource InputCornerRadius}" Margin="3" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Border Background="{DynamicResource ViewBackgroundBrush}" BorderBrush="{DynamicResource TextBrush}"
                                    BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}"
                                    MinWidth="{TemplateBinding ActualWidth}" Padding="3" Margin="0,5,0,0">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboFocus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource TypographyComboBoxItemStyle}">
        <Setter Property="Background" Value="{DynamicResource ViewBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
