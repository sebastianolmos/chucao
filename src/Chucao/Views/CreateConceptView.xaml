<UserControl x:Class="Chucao.Views.CreateConceptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged">
    <StackPanel>
        <TextBlock Text="{Binding Localization[Concepts.Add]}" FontSize="22"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20" />
        <Label Content="{Binding Localization[Concepts.Name]}"
               Target="{Binding ElementName=ConceptInput}" Padding="0,0,0,6" />
        <TextBox x:Name="ConceptInput" MaxLength="30" Padding="8" FontSize="16"
                 Text="{Binding DraftConceptText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Localization[Concepts.Name]}" />
        <TextBlock Text="{Binding Localization[Concepts.NameLimit]}"
                   TextWrapping="Wrap" Margin="0,6,0,16" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="{Binding Localization[Common.Cancel]}" Padding="12,8"
                    Margin="0,0,8,0" Command="{Binding CancelDialogCommand}" />
            <Button Content="{Binding Localization[Common.Confirm]}" Padding="12,8"
                    IsDefault="True" IsEnabled="{Binding CanAddConcept}"
                    Command="{Binding ConfirmAddConceptCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
