<UserControl x:Class="Chucao.Views.ListDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding SelectedList}" FontSize="26" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding HasSeenConcept, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding Localization[Concepts.LastSeen]}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LastSeenConcept}" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Localization[Concepts.NoneSeen]}" Margin="0,8,0,0"
                       TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSeenConcept}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#B8B8B8" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,16,0,16">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UnseenConcepts}"
                              AutomationProperties.Name="{Binding Localization[Concepts.Title]}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Concept}" FontSize="16" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="{Binding DataContext.Localization[Concepts.MarkSeen], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{Binding DataContext.Localization[Concepts.MarkSeenDescription], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.Name="{Binding DataContext.Localization[Concepts.MarkSeenDescription], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.MarkConceptAsSeenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="6,5" Margin="0,0,6,0" />
                                        <Button Content="{Binding DataContext.Localization[Concepts.Delete], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.DeleteConceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="6,5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="{Binding Localization[Concepts.AllSeen]}"
                         TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                         Visibility="{Binding AllConceptsSeen, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Text="{Binding Localization[Concepts.Empty]}"
                         TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                         Visibility="{Binding IsConceptListEmpty, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding AddConceptCommand}"
                        Padding="8" Margin="0,0,4,0">
                    <TextBlock Text="{Binding Localization[Concepts.Add]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Grid.Column="1" IsEnabled="False" Padding="8" Margin="4,0"
                        ToolTip="{Binding Localization[Concepts.AddSetPending]}">
                    <TextBlock Text="{Binding Localization[Concepts.AddSet]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Grid.Column="2" Command="{Binding ResetListCommand}"
                        Padding="8" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Localization[Lists.Reset]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
            </Grid>
            <Button Content="{Binding Localization[Lists.Delete]}" Command="{Binding DeleteListCommand}"
                    Padding="12,8" />
        </StackPanel>
    </Grid>
</UserControl>
