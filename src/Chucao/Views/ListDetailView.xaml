<UserControl x:Class="Chucao.Views.ListDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding SelectedList}" Style="{StaticResource ListTitleTextStyle}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding HasSeenConcept, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding Localization[Concepts.LastSeen]}" Style="{StaticResource SecondaryTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LastSeenConcept}" Style="{StaticResource LastSeenTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Localization[Concepts.NoneSeen]}" Margin="0,8,0,0"
                       TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSeenConcept}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,16,0,16">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UnseenConcepts}"
                              AutomationProperties.Name="{Binding Localization[Concepts.Title]}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="0,0,0,1" Padding="6,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Concept}" Style="{StaticResource ConceptTextStyle}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource OrangeButtonStyle}" Content="{Binding DataContext.Localization[Concepts.MarkSeen], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{Binding DataContext.Localization[Concepts.MarkSeenDescription], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.Name="{Binding DataContext.Localization[Concepts.MarkSeenDescription], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.MarkConceptAsSeenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="6,5" Margin="{DynamicResource InlineActionMargin}" />
                                        <Button Margin="{DynamicResource FinalDialogActionMargin}" Style="{StaticResource RedButtonStyle}" Content="{Binding DataContext.Localization[Concepts.Delete], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.DeleteConceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="6,5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="{Binding Localization[Concepts.AllSeen]}" Style="{StaticResource SecondaryTextStyle}"
                         TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                         Visibility="{Binding AllConceptsSeen, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Text="{Binding Localization[Concepts.Empty]}" Style="{StaticResource SecondaryTextStyle}"
                         TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                         Visibility="{Binding IsConceptListEmpty, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2">
            <Grid Margin="{DynamicResource ActionRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GreenButtonStyle}" Grid.Column="0" Command="{Binding AddConceptCommand}"
                        Padding="8" Margin="{DynamicResource LeftActionMargin}">
                    <TextBlock Text="{Binding Localization[Concepts.Add]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Style="{StaticResource BlueButtonStyle}" Grid.Column="1" Command="{Binding AddConceptSetCommand}" Padding="8" Margin="{DynamicResource MiddleActionMargin}">
                    <TextBlock Text="{Binding Localization[Concepts.AddSet]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Style="{StaticResource PinkButtonStyle}" Grid.Column="2" Command="{Binding ResetListCommand}"
                        Padding="8" Margin="{DynamicResource RightActionMargin}">
                    <TextBlock Text="{Binding Localization[Lists.Reset]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PurpleButtonStyle}" Command="{Binding SelectRandomConceptCommand}" IsEnabled="{Binding CanSelectRandomConcept}"
                        Padding="8" Margin="{DynamicResource LeftActionMargin}" MinHeight="48">
                    <TextBlock Text="{Binding Localization[Concepts.SelectRandom]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Style="{StaticResource RedButtonStyle}" Grid.Column="1" Command="{Binding DeleteListCommand}"
                        Padding="8" Margin="{DynamicResource RightActionMargin}" MinHeight="48">
                    <TextBlock Text="{Binding Localization[Lists.Delete]}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
