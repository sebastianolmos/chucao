<UserControl x:Class="Chucao.Views.DeleteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged">
    <StackPanel>
        <TextBlock Text="{Binding Localization[Lists.DeleteQuestion]}" Style="{StaticResource SmallDialogTitleTextStyle}"
                    TextWrapping="Wrap" />
        <TextBlock Text="{Binding SelectedList}" Style="{StaticResource ConceptTextStyle}" TextWrapping="Wrap" Margin="0,12,0,24" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Style="{StaticResource OrangeButtonStyle}" x:Name="CancelDeleteButton" Content="{Binding Localization[Common.Cancel]}"
                    Padding="12,8" Margin="{DynamicResource DialogActionMargin}" Command="{Binding CancelDialogCommand}" />
            <Button Margin="{DynamicResource FinalDialogActionMargin}" Style="{StaticResource RedButtonStyle}" Content="{Binding Localization[Lists.Delete]}" Padding="12,8"
                    Command="{Binding ConfirmDeleteCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
