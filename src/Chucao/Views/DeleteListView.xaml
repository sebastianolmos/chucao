<UserControl x:Class="Chucao.Views.DeleteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged">
    <StackPanel>
        <TextBlock Text="{Binding Localization[Lists.DeleteQuestion]}" FontSize="20"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SelectedList}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,24" />
        <WrapPanel HorizontalAlignment="Right">
            <Button x:Name="CancelDeleteButton" Content="{Binding Localization[Common.Cancel]}"
                    Padding="12,8" Margin="0,0,8,0" Command="{Binding CancelDialogCommand}" />
            <Button Content="{Binding Localization[Lists.Delete]}" Padding="12,8"
                    Command="{Binding ConfirmDeleteCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
