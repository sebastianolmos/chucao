<Window x:Class="Chucao.Views.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}" Title="{Binding [Window.Title]}"
        Language="{Binding CurrentLanguage, ConverterCulture=en}"
        Width="420" SizeToContent="Height" MaxHeight="550"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="380">
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        </ScrollViewer>
        <Button Grid.Row="1" Content="{Binding [Common.OK]}" Padding="16,8" Margin="0,20,0,0"
                HorizontalAlignment="Right" MinWidth="80" IsDefault="True" IsCancel="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
