<UserControl x:Class="Chucao.Views.SelectedConceptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged">
    <StackPanel>
        <TextBlock Text="{Binding Localization[Concepts.SelectedTitle]}" Style="{StaticResource DialogCaptionTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SelectedConcept}" Style="{StaticResource SelectedConceptTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,24" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource BackButtonStyle}" x:Name="ReturnButton" Content="{Binding Localization[Lists.Back]}"
                    Command="{Binding CancelDialogCommand}" Padding="8" Margin="{DynamicResource LeftActionMargin}" />
            <Button Style="{StaticResource PurpleButtonStyle}" Grid.Column="1" Command="{Binding OpenConceptTimerCommand}" Padding="8" Margin="{DynamicResource RightActionMargin}">
                <TextBlock Text="{Binding Localization[Concepts.OpenTimer]}"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
