<UserControl x:Class="Chucao.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContextChanged="View_DataContextChanged">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <Image x:Name="HomeBirdImage" Source="{DynamicResource ApplicationImage}"
                   Width="96" Height="96" Stretch="Uniform" Margin="0,0,0,8"
                   HorizontalAlignment="Center" Focusable="False">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <TextBlock Text="{Binding Localization[Window.Title]}" Style="{StaticResource AppTitleTextStyle}"
                        TextAlignment="Center" />
            <TextBlock Text="{Binding Localization[Practice.Subtitle]}" Style="{StaticResource SubtitleTextStyle}"
                       Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#B8B8B8" BorderThickness="1" CornerRadius="6" Padding="12">
            <ScrollViewer x:Name="ListsScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Lists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="4" Padding="8" MinHeight="60"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Command="{Binding DataContext.OpenListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource ListCardTextStyle}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddListButton" Content="{Binding Localization[Lists.AddSymbol]}"
                            Margin="4,10,4,4"
                            ToolTip="{Binding Localization[Lists.Create]}"
                            AutomationProperties.Name="{Binding Localization[Lists.Create]}"
                            Style="{StaticResource AddListButtonStyle}" MinHeight="40" Command="{Binding CreateListCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button x:Name="TimerButton" Grid.Row="2" Content="{Binding Localization[Timer.Title]}"
                Command="{Binding OpenTimerCommand}" Padding="12,10" Margin="0,16,0,0" />
    </Grid>
</UserControl>
