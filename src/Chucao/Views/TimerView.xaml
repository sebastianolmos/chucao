<UserControl x:Class="Chucao.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged" Unloaded="View_Unloaded">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Localization[Timer.Title]}" Style="{StaticResource PageTitleTextStyle}"
                   TextAlignment="Center" />
        <!-- Logical scene dimensions live in Palette.xaml; scale down only when space is limited. -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,12"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="AnimationCanvas" Width="{DynamicResource AnimationCanvasWidth}" Height="{DynamicResource AnimationCanvasHeight}"
                    Background="{DynamicResource AnimationBrush}" SizeChanged="AnimationCanvas_SizeChanged">
                <Canvas.Clip>
                    <RectangleGeometry x:Name="AnimationClip"
                                       RadiusX="{DynamicResource AnimationCornerRadius}"
                                       RadiusY="{DynamicResource AnimationCornerRadius}" />
                </Canvas.Clip>
                <!-- Reference scene coordinates (366 x 256), scaled to fill the canvas. -->
                <Viewbox Width="{Binding ActualWidth, ElementName=AnimationCanvas}"
                         Height="{Binding ActualHeight, ElementName=AnimationCanvas}"
                         Stretch="Fill" IsHitTestVisible="False">
                    <Canvas Width="366" Height="256">
                        <Rectangle Canvas.Top="55" Width="366" Height="201"
                                   Fill="{DynamicResource AnimationGroundBrush}" />
                        <Polygon Points="168,55 208,55 289,256 63,256"
                                 Fill="{DynamicResource AnimationPathBrush}" />
                    </Canvas>
                </Viewbox>
                <!-- Stumps sit above the landscape and behind the bird. -->
                <Canvas x:Name="StumpLayer" IsHitTestVisible="False" />
                <Image x:Name="BirdImage" Source="{DynamicResource ApplicationImage}"
                       Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                       IsHitTestVisible="False" Focusable="False">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="BirdScale" ScaleX="1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Viewbox>
        <TextBlock Grid.Row="2" Text="{Binding Timer.Concept}" Style="{StaticResource TimerConceptTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8" />
        <!-- Fixed character cells keep the clock centered even with proportional numerals. -->
        <StackPanel x:Name="TimerDigits" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding Localization[Timer.Remaining]}"
                    AutomationProperties.HelpText="{Binding Timer.DisplayTime}">
            <TextBlock Text="{Binding Timer.DisplayTime[0]}" Style="{StaticResource TimerDigitsTextStyle}"
                       Width="{DynamicResource TimerDigitCellWidth}" TextAlignment="Center" />
            <TextBlock Text="{Binding Timer.DisplayTime[1]}" Style="{StaticResource TimerDigitsTextStyle}"
                       Width="{DynamicResource TimerDigitCellWidth}" TextAlignment="Center" />
            <TextBlock Text="{Binding Timer.DisplayTime[2]}" Style="{StaticResource TimerDigitsTextStyle}"
                       Width="{DynamicResource TimerSeparatorCellWidth}" TextAlignment="Center" />
            <TextBlock Text="{Binding Timer.DisplayTime[3]}" Style="{StaticResource TimerDigitsTextStyle}"
                       Width="{DynamicResource TimerDigitCellWidth}" TextAlignment="Center" />
            <TextBlock Text="{Binding Timer.DisplayTime[4]}" Style="{StaticResource TimerDigitsTextStyle}"
                       Width="{DynamicResource TimerDigitCellWidth}" TextAlignment="Center" />
        </StackPanel>
        <Button Style="{StaticResource GreenButtonStyle}" x:Name="StartButton" Grid.Row="4" Width="120" HorizontalAlignment="Center"
                Command="{Binding Timer.ToggleCommand}" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <!-- Reserve the restart label's space so finishing cannot shrink the scene. -->
                <TextBlock Text="{Binding Localization[Timer.Restart]}" Visibility="Hidden"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="{Binding Timer.ActionText}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
