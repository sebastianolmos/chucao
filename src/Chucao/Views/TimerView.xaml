<UserControl x:Class="Chucao.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged" Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" MinHeight="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Localization[Timer.Title]}" Style="{StaticResource PageTitleTextStyle}"
                   TextAlignment="Center" />
        <!-- A square placeholder scales down to the available space without moving the timer. -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,12"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="{DynamicResource AnimationCanvasSize}" Height="{DynamicResource AnimationCanvasSize}"
                    Background="{DynamicResource AnimationBrush}" BorderBrush="{DynamicResource TextBrush}"
                    BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}" />
        </Viewbox>
        <TextBlock Grid.Row="2" Text="{Binding Timer.Concept}" Style="{StaticResource TimerConceptTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8" />
        <TextBlock Grid.Row="3" Text="{Binding Timer.DisplayTime}" Style="{StaticResource TimerDigitsTextStyle}"
                   TextAlignment="Center" AutomationProperties.Name="{Binding Localization[Timer.Remaining]}" />
        <TextBlock Grid.Row="4" Text="{Binding Localization[Timer.Finished]}" TextAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap" Margin="0,4,0,8"
                   Visibility="{Binding Timer.IsFinished, Converter={StaticResource BooleanToVisibility}}" />
        <Button Style="{StaticResource GreenButtonStyle}" x:Name="StartButton" Grid.Row="5" Width="120" HorizontalAlignment="Center"
                Command="{Binding Timer.ToggleCommand}" Padding="12,10" Margin="0,12,0,0">
            <TextBlock Text="{Binding Timer.ActionText}" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
    </Grid>
</UserControl>
