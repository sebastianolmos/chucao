<UserControl x:Class="Chucao.Views.AddConceptSetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="View_IsVisibleChanged">
    <StackPanel>
        <TextBlock Text="{Binding Localization[Concepts.AddSet]}" Style="{StaticResource DialogTitleTextStyle}"
                    TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="{Binding Localization[Concepts.SetInstructions]}" Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <Label Content="{Binding Localization[Concepts.SetInput]}"
               Target="{Binding ElementName=ConceptSetInput}" Padding="0,0,0,6" />
        <TextBox x:Name="ConceptSetInput" Height="180" Padding="8"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Text="{Binding DraftConceptSet, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Localization[Concepts.SetInput]}" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource RedButtonStyle}" Content="{Binding Localization[Common.Cancel]}" Padding="12,8"
                    Margin="{DynamicResource DialogActionMargin}" Command="{Binding CancelDialogCommand}" />
            <Button Margin="{DynamicResource FinalDialogActionMargin}" Style="{StaticResource GreenButtonStyle}" Content="{Binding Localization[Common.Confirm]}" Padding="12,8"
                    IsDefault="True" IsEnabled="{Binding CanAddConceptSet}"
                    Command="{Binding ConfirmAddConceptSetCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
